# ─────────────────────────────────────────────────────────────
# Ordinex Backend — environment variables
# Copy to .env and fill in real values for local development.
# Never commit .env with real credentials.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=Ordinex Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# ── MongoDB ──────────────────────────────────────────────────
# Local dev:           mongodb://localhost:27017
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ordinex

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all (dev only)
CORS_ORIGINS=*

# ── File storage ─────────────────────────────────────────────
UPLOAD_DIR=uploads
REPORTS_DIR=reports
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx

# ── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Pagination ───────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
